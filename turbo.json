{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "set-version": {
      "cache": false,
      "passThroughEnv": ["VERSION"]
    },
    "pack": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["*.tgz"]
    },
    "publish": {
      "dependsOn": ["^publish"],
      "cache": false,
      "passThroughEnv": ["NPM_TAG"]
    }
  }
}
