{
  "name": "@gramdown/workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "prettier": "@tobysmith568/prettier-config",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint scripts",
    "check": "turbo run build typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "set-version": "turbo run set-version",
    "compile:binaries": "bun run scripts/compile-binaries.ts",
    "pack": "turbo run pack",
    "publish": "turbo run publish"
  },
  "devDependencies": {
    "@tobysmith568/eslint-config": "^2.7.1",
    "@tobysmith568/prettier-config": "^2.2.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.19.13",
    "eslint": "^9.39.3",
    "prettier": "^3.8.1",
    "tsdown": "^0.22.14",
    "turbo": "^2.5.5",
    "typescript": "~5.9.3"
  }
}
