---
import ConverterPanel from "../components/converter/ConverterPanel";
import Section from "../components/Section.astro";
import { cliNpmUrl, coreNpmUrl, repoUrl } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sampleConversion } from "../lib/converter/sample";

const description =
  "Convert Grammarly's .docx export into clean, GitHub-flavored Markdown. gramdown is a command line tool for Windows, macOS and Linux, and a browser converter.";

const install = [
  "curl -fsSL https://gramdown.tobythe.dev/install.sh | sh",
  "gramdown draft.docx -o draft.md"
];

const tail = [
  { href: "/docs", label: "Documentation" },
  { href: "/docs/how-it-works", label: "How it works" },
  { href: "/docs/downloads", label: "Standalone binaries" },
  { href: repoUrl, label: "GitHub" },
  { href: cliNpmUrl, label: "gramdown on npm" },
  { href: coreNpmUrl, label: "@gramdown/core on npm" }
];
---

<BaseLayout description={description}>
  <section class="wrap hero">
    <h1>Turn a Grammarly export into clean Markdown</h1>
    <p class="lead">
      gramdown is a small command-line tool that converts Grammarly's <code>.docx</code> export into clean,
      GitHub-flavored Markdown. Built for Grammarly's quirks, so things like code blocks and links come
      out just right.
    </p>

    <div class="cmd">
      {install.map(line => <code class="cmd-line">{line}</code>)}
    </div>

    <p class="cmd-note">
      Windows, or prefer npm? See <a href="/docs/downloads">Downloads</a> for every option.
    </p>

    <p class="hero-links">
      <a href="/docs">Documentation</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="#converter">Convert in your browser</a>
    </p>
  </section>

  <Section id="converter" aria-labelledby="converter-heading">
    <h2 id="converter-heading">Convert in your browser</h2>
    <p class="sec-lead">
      Every page on this site runs the same converter. Drop a Grammarly <code>.docx</code> and it is converted
      on your device. No upload, no account, no server. The example below is real output; drop a file
      to replace it with your own.
    </p>
    <ConverterPanel sample={sampleConversion} client:load />
  </Section>

  <Section>
    <nav class="tail" aria-label="More">
      {tail.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>
  </Section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--sp-8) var(--sp-7);
  }

  .hero h1 {
    margin: 0 0 var(--sp-4);
    max-width: 22ch;
    font-size: var(--text-3xl);
    text-wrap: balance;
  }

  .lead {
    max-width: var(--measure-wide);
    margin: 0 0 var(--sp-6);
    font-size: var(--text-lg);
  }

  .lead code,
  .sec-lead code,
  .hero-links code {
    padding: 0;
    background: none;
    border: none;
  }

  /* The install command is the input side of the story as much as the drop zone is, so its
     accent rule is --source green rather than a plain border (matches the docs install block). */
  .cmd {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: fit-content;
    padding: var(--sp-5) var(--sp-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--source);
    border-radius: var(--radius);
    overflow-x: auto;
  }

  .cmd-line {
    padding: 0;
    background: none;
    border: none;
    font-family: var(--f-mono);
    font-size: var(--text-base);
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .cmd-line::before {
    content: "$ ";
    color: var(--source-ink);
    user-select: none;
  }

  .cmd-note {
    max-width: var(--measure-wide);
    margin: var(--sp-3) 0 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .hero-links {
    margin: var(--sp-5) 0 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .hero-links .dot {
    margin: 0 var(--sp-3);
    color: var(--border);
  }

  #converter h2 {
    margin: 0 0 var(--sp-3);
    font-size: var(--text-2xl);
  }

  .sec-lead {
    max-width: var(--measure-wide);
    margin: 0 0 var(--sp-6);
    color: var(--muted);
  }

  .tail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    font-size: var(--text-sm);
  }

  @media (max-width: 44rem) {
    .cmd {
      padding: var(--sp-4);
    }

    .cmd-line {
      font-size: var(--text-sm);
    }
  }
</style>
