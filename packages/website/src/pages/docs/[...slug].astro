---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export const getStaticPaths = async () => {
  const docs = await getCollection("docs");
  const navItems = docs.sort((a, b) => a.data.order - b.data.order);

  // `index` is the section landing page - Astro maps `slug: undefined` on a rest
  // param to the bare `/docs` route.
  const paths = navItems.map(entry => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry, navItems }
  }));

  return paths;
};

const { entry, navItems } = Astro.props;
const { Content } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  navItems={navItems}
  currentId={entry.id}>
  <Content />
</DocsLayout>
