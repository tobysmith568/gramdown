---
import { cliNpmUrl, repoUrl } from "../consts";

const year = new Date().getUTCFullYear();

const nav = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/downloads", label: "Downloads" },
  { href: repoUrl, label: "GitHub" },
  { href: cliNpmUrl, label: "npm" }
];

const legal = [
  { href: "/terms", label: "Terms" },
  { href: "/privacy", label: "Privacy" },
  { href: "/cookies", label: "Cookies" }
];
---

<footer>
  <div class="wrap inner">
    <div class="row nav">
      {nav.map(({ href, label }) => <a href={href}>{label}</a>)}
    </div>
    <div class="row meta">
      <span>© Toby Smith {year}</span>
      {legal.map(({ href, label }) => <a href={href}>{label}</a>)}
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding-block: var(--sp-6) var(--sp-7);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  /* Two independent rows - each wraps on its own, items separated by space, not dots. */
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
  }

  /* Nav links match the header: no resting underline, muted lifting to ink. */
  .nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav a:hover {
    color: var(--ink);
  }

  /* Legal links read as prose references, so they keep the site-wide link treatment
     (colour + underline, set on the bare `a` in global.css) rather than the nav row's
     muted/ink chrome pattern; only the hover colour needs restating here. */
  .meta a:hover {
    color: var(--ink);
  }
</style>
