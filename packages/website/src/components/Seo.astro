---
// Every <head> tag that isn't a stylesheet, a font preload or the viewport: the title,
// the description, the canonical, the robots directive, the icon set and the social card.
// It all used to be spread through BaseLayout, where each new page-level need grew another
// inline conditional (milestone 8.10.8).
//
// Pages pass their own bare title and description; the decoration (the " - gramdown"
// suffix, the absolute URLs, the icon links) is this component's business alone.
import { indexingDisabled, siteName } from "../consts";

interface Props {
  /** The page's own title, undecorated. Omitted on the index, which is the site itself. */
  title?: string;
  description: string;
  /** Keep this page out of search results even after launch (the legal pages, the 404). */
  noIndex?: boolean;
}

const { title: pageTitle, description, noIndex } = Astro.props;

// The index passes no title and gets the site's, which carries its own tagline rather than
// the bare wordmark: "gramdown" alone tells a search result nothing.
const siteTitle = `${siteName} - Convert Grammarly .docx exports to Markdown`;
const title = pageTitle ? `${pageTitle} - ${siteName}` : siteTitle;

// `build.format: "file"` makes the built pathname the emitted filename (`/docs/cli.html`,
// `/index.html`), but the page is served, linked and listed in the sitemap at the
// extensionless path. A canonical that disagrees with the sitemap is worse than none.
const servedPath = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "");
const canonical = new URL(servedPath, Astro.site);

// The social card is one image for the whole site: a three-page site does not have enough
// distinct pages for per-page cards to earn their generation cost, and a wrong-but-specific
// card is worse than a right-but-general one. Built by `bun run brand:assets`.
const ogImage = new URL("/og.png", Astro.site);
const ogImageAlt = "gramdown: clean Markdown from your Grammarly .docx exports";
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="generator" content={Astro.generator} />

{
  /* SVG first: browsers that understand it take it. The .ico is for clients that hardcode
     /favicon.ico, the apple-touch-icon for the iOS home screen. Both icons are transparent
     so they read as a shape against whatever tab strip is behind them, rather than as a
     rectangle; the SVG's dark block is a bonus for the browsers that honour it (Safari
     renders SVG favicons but ignores their embedded styles) rather than something the
     colours depend on. */
}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

{/* The browser chrome takes the page ground, so the two meet without a seam. */}
<meta name="theme-color" content="#f5efe3" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1a160f" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={ogImageAlt} />

{
  /* Pre-launch the whole site is held back (see `indexingDisabled`); after the flip, only
     the pages that asked to be left out are. */
  indexingDisabled ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    noIndex && <meta name="robots" content="noindex" />
  )
}
