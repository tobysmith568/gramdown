---
// Long-form content styling for the docs and the legal pages. The rendered MDX
// <slot /> is the only markup here; every rule is scoped to `.prose` so island and
// page chrome elsewhere are untouched.
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    /* URLs used as link text and long package names must wrap, not widen the page. */
    overflow-wrap: break-word;
  }

  .prose :global(> :first-child) {
    margin-top: 0;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-3);
  }

  .prose :global(h2) {
    font-size: var(--text-xl);
  }

  .prose :global(h3) {
    font-size: var(--text-lg);
  }

  .prose :global(h4) {
    font-size: var(--text-base);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    max-width: 44rem;
  }

  /* Links inherit the site-wide treatment from global.css (--brand-ink, quiet resting
     underline promoted to a firm ink underline on hover/focus). Prose only adds the
     aggressive wrap so a bare URL used as link text can't widen the column. */
  .prose :global(a) {
    overflow-wrap: anywhere;
  }

  .prose :global(:not(pre) > code) {
    font-size: 0.9em;
  }

  /* Shiki paints only the syntax colours now (Vitesse; global.css swaps to the --shiki-dark*
     values under the dark palette and forces the frame fill to --surface in both themes).
     The frame - border, radius, the amber marker rule - is ours. */
  .prose :global(pre.astro-code) {
    margin: var(--sp-4) 0;
    padding: var(--sp-4) var(--sp-5);
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-left: 2px solid var(--brand);
    border-radius: var(--radius);
  }

  .prose :global(blockquote) {
    margin: var(--sp-4) 0;
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 2px solid var(--brand);
    border-radius: var(--radius);
  }

  .prose :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  /* A wide table (a Type column full of code, say) scrolls inside its own frame rather
     than widening the page - the same containment the code frames get. `display: block`
     turns the table itself into the scroll container; `width: max-content` lets it take
     its natural width up to the column edge before the scrollbar appears. */
  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--sp-3) var(--sp-4);
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--muted);
    font-weight: 600;
  }

  .prose :global(hr) {
    margin: var(--sp-6) 0;
    border: none;
    border-top: 1px solid var(--border);
  }
</style>
