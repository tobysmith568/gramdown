---
const links = [
  { href: "/docs", label: "Docs" },
  { href: "https://github.com/tobysmith568/gramdown", label: "GitHub" },
  { href: "https://www.npmjs.com/package/gramdown", label: "npm" }
];

const currentPath = Astro.url.pathname.replace(/\.html$/, "").replace(/(.)\/$/, "$1");

const isActive = (href: string) =>
  href.startsWith("/") && (currentPath === href || currentPath.startsWith(href + "/"));
---

<header>
  <nav class="wrap bar" aria-label="Primary">
    <a class="id" href="/">gramdown</a>

    <div class="links">
      {
        links.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--sp-4);
  }

  .id {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }

  .links {
    display: flex;
    gap: var(--sp-5);
    font-size: var(--text-sm);
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--ink);
  }
</style>
