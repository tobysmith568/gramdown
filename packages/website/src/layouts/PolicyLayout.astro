---
import Prose from "../components/Prose.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  lastUpdated: Date;
}

const { title, description, lastUpdated } = Astro.props;

// Deterministic across builds regardless of the runner's locale (matches release.ts).
const humanDate = lastUpdated.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC"
});
const machineDate = lastUpdated.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description} noIndex>
  <div class="wrap policy">
    <div class="rail">
      <a class="back" href="/">← Home</a>
      <time datetime={machineDate}>Updated {humanDate}</time>
    </div>

    <article class="body">
      <Prose>
        <slot />
      </Prose>
    </article>
  </div>
</BaseLayout>

<style>
  .policy {
    display: grid;
    gap: var(--sp-5);
    padding-block: var(--sp-6) var(--sp-9);
  }

  .rail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-3) var(--sp-5);
    font-family: var(--f-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .back {
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  .body {
    min-width: 0;
    font-size: var(--text-base);
  }

  /* The only <h1> the slotted MDX carries is the policy's own title. Prose.astro sizes h2+
     but leaves h1 to its callers (DocsLayout renders one itself), so set it here. */
  .body :global(.prose h1) {
    margin: 0 0 var(--sp-5);
    font-size: var(--text-xl);
  }

  @media (min-width: 48rem) {
    .policy {
      grid-template-columns: 11rem 1fr;
      gap: var(--sp-7);
      padding-block: var(--sp-7) var(--sp-9);
    }

    .rail {
      flex-direction: column;
      gap: var(--sp-3);
      position: sticky;
      top: var(--sp-5);
      align-self: start;
    }
  }
</style>
