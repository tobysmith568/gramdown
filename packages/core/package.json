{
  "name": "@gramdown/core",
  "version": "0.0.0",
  "description": "The pure, I/O-free engine that turns a Grammarly .docx export into clean, GitHub-Flavored Markdown.",
  "license": "ISC",
  "author": {
    "name": "Toby Smith",
    "url": "https://tobysmith.uk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/gramdown.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/gramdown/issues"
  },
  "homepage": "https://gramdown.tobythe.dev",
  "keywords": [
    "grammarly",
    "docx",
    "markdown",
    "gfm",
    "converter"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./guess-lang": {
      "types": "./dist/guess-lang.d.ts",
      "import": "./dist/guess-lang.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "test": "bun test",
    "test:update": "bun run test/update-fixtures.ts",
    "set-version": "bun pm pkg set version=$VERSION",
    "pack": "bun pm pack",
    "publish": "npm publish *.tgz --access public --provenance --tag $NPM_TAG"
  },
  "dependencies": {
    "flourite": "^1.3.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@gramdown/fixtures": "workspace:*",
    "@types/turndown": "^5.0.6"
  }
}
