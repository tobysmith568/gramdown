{
  "name": "gramdown",
  "version": "0.0.0",
  "description": "Turn a Grammarly .docx export into clean, GitHub-Flavored Markdown, from the command line.",
  "license": "ISC",
  "author": {
    "name": "Toby Smith",
    "url": "https://tobysmith.uk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/gramdown.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/gramdown/issues"
  },
  "homepage": "https://gramdown.tobythe.dev",
  "keywords": [
    "grammarly",
    "docx",
    "markdown",
    "gfm",
    "converter",
    "cli"
  ],
  "type": "module",
  "bin": {
    "gramdown": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test",
    "compile": "bun build ./src/bin.ts --compile --minify --bytecode --outfile gramdown",
    "set-version": "bun pm pkg set version=$VERSION dependencies.@gramdown/core=$VERSION",
    "pack": "bun pm pack",
    "publish": "npm publish *.tgz --access public --provenance --tag $NPM_TAG"
  },
  "dependencies": {
    "@gramdown/core": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@gramdown/fixtures": "workspace:*"
  }
}
